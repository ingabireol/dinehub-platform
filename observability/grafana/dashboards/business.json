{
  "uid": "dinehub-business",
  "title": "DineHub \u2014 Business",
  "description": "Orders, payments, the kitchen and notifications. Every panel here can be wrong while every service is green, which is the point of having it.",
  "tags": [
    "dinehub",
    "business"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "DineHub",
      "tags": [
        "dinehub"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Orders placed",
      "description": "Over the dashboard's time range. The number the restaurant cares about; every technical metric on the other dashboards exists to keep this one moving.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(dinehub_orders_placed_total[$__range]))",
          "legendFormat": "orders",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Payment success rate",
      "description": "Completed against completed plus failed. In dev and test a share of payments is declined on purpose, so a number below 100 here is expected outside production.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(increase(dinehub_payments_completed_total[$__range])) / clamp_min(sum(increase(dinehub_payments_completed_total[$__range])) + sum(increase(dinehub_payments_failed_total[$__range])), 1)",
          "legendFormat": "success",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Cancellation rate",
      "description": "Cancelled as a share of placed. Rises when payments are failing, so read it next to the panel on its left before concluding anything about customers.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(increase(dinehub_orders_cancelled_total[$__range])) / clamp_min(sum(increase(dinehub_orders_placed_total[$__range])), 1)",
          "legendFormat": "cancelled",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Median preparation time",
      "description": "From the kitchen accepting a ticket to marking it ready. The one number here that no amount of engineering improves.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(dinehub_kitchen_preparation_duration_seconds_bucket[$__range])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Orders stuck",
      "description": "Orders that have sat in PLACED past the sweep threshold. Anything other than zero means the event chain has broken somewhere between order and payment \u2014 start at the dead-letter queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(dinehub_orders_stuck)",
          "legendFormat": "stuck",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",

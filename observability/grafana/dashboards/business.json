      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Orders placed and cancelled",
      "description": "Per minute. The two lines move together during a payment incident, which is how you tell one from a change in demand.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(dinehub_orders_placed_total[$__rate_interval])) * 60",
          "legendFormat": "placed",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(dinehub_orders_cancelled_total[$__rate_interval])) * 60",
          "legendFormat": "cancelled",
          "range": true,
          "instant": false,
          "refId": "B",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisBorderShow": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "mappings": [],
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "placed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {

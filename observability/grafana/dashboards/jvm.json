        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service) (jvm_memory_used_bytes{job=~\"dinehub.*\", service=~\"$service\", area=\"heap\"})",
          "legendFormat": "{{service}}",
          "range": true,

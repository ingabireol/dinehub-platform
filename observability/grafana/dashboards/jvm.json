{
  "uid": "dinehub-jvm",
  "title": "DineHub \u2014 JVM and runtime",
  "description": "Heap, garbage collection, connection pools and threads for every service. Opened when the overview says a service is slow and the question is why.",
  "tags": [
    "dinehub",
    "jvm",
    "runtime"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "dinehub-prometheus"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": {
          "query": "label_values(up{job=~\"dinehub.*\"}, service)",
          "refId": "svc"
        },
        "definition": "label_values(up{job=~\"dinehub.*\"}, service)",
        "sort": 1,
        "options": [],
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "DineHub",
      "tags": [
        "dinehub"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Heap used",
      "description": "Across the selected services. Growth that never comes back down between collections is the shape of a leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{job=~\"dinehub.*\", service=~\"$service\", area=\"heap\"})",
          "legendFormat": "heap",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Worst heap pressure",
      "description": "The service closest to its own heap ceiling. An average across services would hide exactly the one about to be killed.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * max(jvm_memory_used_bytes{job=~\"dinehub.*\", service=~\"$service\", area=\"heap\"} / clamp_min(jvm_memory_max_bytes{job=~\"dinehub.*\", service=~\"$service\", area=\"heap\"}, 1))",
          "legendFormat": "worst",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 92
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "GC overhead",
      "description": "Share of wall-clock time spent collecting. Above a few percent the JVM is working for itself rather than for anyone else.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * max(jvm_gc_overhead{job=~\"dinehub.*\", service=~\"$service\"})",
          "legendFormat": "overhead",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Live threads",
      "description": "Total across the selected services. A number that only goes up is a thread leak, usually an executor nobody shuts down.",
      "datasource": {
        "type": "prometheus",
        "uid": "dinehub-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dinehub-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(jvm_threads_live_threads{job=~\"dinehub.*\", service=~\"$service\"})",
          "legendFormat": "threads",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {

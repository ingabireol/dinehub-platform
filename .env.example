# ---------------------------------------------------------------------------
# Copy to .env for local development:  cp .env.example .env
#
# .env is git-ignored. These values are local-only defaults and are safe to
# publish precisely because nothing real uses them — every deployed environment
# injects its own from a Kubernetes Secret created out of GitHub Secrets.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=dinehub
DB_PASSWORD=dinehub

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=dinehub
RABBITMQ_PASSWORD=dinehub

# --- Redis (gateway rate limiting) -----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT -------------------------------------------------------------------
# Must be at least 32 bytes. The services refuse to start without it — there is
# deliberately no default, because a default signing key is the kind of thing
# that reaches production unnoticed.
JWT_SECRET=local-development-signing-key-not-for-any-real-use
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Behaviour -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=DEBUG
SWAGGER_ENABLED=true

# --- Payment simulation ----------------------------------------------------
# Fraction of payments that fail, so the failure path is exercisable on demand.
PAYMENT_FAILURE_RATE=0.1

# --- Host port overrides for `make up` -------------------------------------
# Set these only if something is already listening on the default. The ports
# inside the compose network never change.
# POSTGRES_PORT=5432
# RABBITMQ_PORT_HOST=5672
# RABBITMQ_UI_PORT=15672
# GATEWAY_PORT=8080
# AUTH_PORT=8081
# MENU_PORT=8082
